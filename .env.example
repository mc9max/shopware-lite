# Copy to .env or set as Railway service variables. All values have safe
# defaults baked into the template; only SHOPWARE_ADMIN_PASSWORD is a
# per-install secret (auto-generated by Railway on template deploy).

# Public domain of the shop — auto-filled by Railway once a domain is attached.
SHOP_DOMAIN=${{RAILWAY_PUBLIC_DOMAIN}}

# Admin backend password (username: admin). Rotated from the default on first boot.
SHOPWARE_ADMIN_PASSWORD=

# Run scheduled tasks + message queue workers via cron (1 = on).
SW_TASKS_ENABLED=1

# Default shop currency (USD, EUR, GBP...). not-set = install default.
SW_CURRENCY=not-set

# Container timezone.
TZ=UTC

# IPs/CIDRs trusted as the TLS-terminating proxy (Symfony X-Forwarded-* handling).
TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
